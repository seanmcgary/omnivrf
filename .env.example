# .env example 

# Ethereum sepolia fork URL used for AVS devnet
L1_FORK_URL=<RPC URL>

# Ethereum sepolia fork URL used for AVS devnet
L2_FORK_URL=<RPC URL>

# VRF Configuration
# Private key for VRF computation (hex format, without 0x prefix)
# Generate using: ./scripts/generate-vrf-key.sh
VRF_PRIVATE_KEY=<hex_private_key>

# Key Manager Configuration
# Options: "env" (default), "aws"
KEY_MANAGER_TYPE=env

# AWS Secrets Manager configuration (only if KEY_MANAGER_TYPE=aws)
# AWS_SECRET_NAME=omnivrf-operator-key
# AWS_REGION=us-east-1